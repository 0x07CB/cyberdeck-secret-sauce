# ─────────────────────────────────────────────────────────────────────────────
# cyberdeck-secret-sauce — Environment configuration template
# Copy this file to .env and adjust values for your machine.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The .env file is git-ignored; NEVER commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Execution mode ────────────────────────────────────────────────────────────
# DRY_RUN=true  → only print what would happen, nothing is changed.
# DRY_RUN=false → live execution (default).
DRY_RUN=false

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL: info | debug
LOG_LEVEL=info

# ── Target user ───────────────────────────────────────────────────────────────
# Defaults to $SUDO_USER or $USER when running as root.
# Explicitly set this when running in non-interactive environments.
# TARGET_USER=youruser

# ── Phases to execute ─────────────────────────────────────────────────────────
# Space-separated list of phases. Accepted values:
#   before   — pre-flight checks & snapshots
#   install  — package installation & tool setup
#   after    — cleanup & verification
#   ssh      — SSH key generation & configuration
# Default: "before install after"
# PHASES="before install after ssh"

# ── Dotfiles ──────────────────────────────────────────────────────────────────
# Git repository URL for your dotfiles (leave empty to skip).
# DOTFILES_REPO=https://github.com/youruser/dotfiles.git

# Local directory where dotfiles will be cloned.
# DOTFILES_DIR=${HOME}/.dotfiles

# ── Extra packages ────────────────────────────────────────────────────────────
# Space-separated list of additional apt packages to install.
# EXTRA_PACKAGES="htop tree jq"

# ── SSH key settings ──────────────────────────────────────────────────────────
# Key type: ed25519 (recommended) | rsa
SSH_KEY_TYPE=ed25519

# Bits — only used when SSH_KEY_TYPE=rsa.
SSH_KEY_BITS=4096

# Comment embedded in the key (visible in authorized_keys).
# SSH_KEY_COMMENT=youruser@cyberdeck
